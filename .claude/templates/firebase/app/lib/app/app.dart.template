import 'package:flutter/material.dart';
import 'package:flutter/scheduler.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:go_router/go_router.dart';

import '../l10n/app_localizations.dart';
import 'current_location.dart';
import 'router.dart';

/// 앱 바깥 틀 — 라우터·문구 파일·테마를 잇습니다.
///
/// 테마는 디자인 시스템(`lib/core/design/`)을 들인 뒤
/// `theme: buildAppTheme(AppTokens.light)`로 잇습니다 — 목업 캔버스와 같은 값.
///
/// [devRoutes]·[devBranchRoutes]는 라우터의 개발용 경로 주입 자리로 그대로
/// 넘깁니다(`router.dart`). 개발용 진입점만 채웁니다.
class App extends ConsumerStatefulWidget {
  const App({
    super.key,
    this.devRoutes = const [],
    this.devBranchRoutes = const {},
  });

  final List<RouteBase> devRoutes;
  final Map<String, List<RouteBase>> devBranchRoutes;

  @override
  ConsumerState<App> createState() => _AppState();
}

class _AppState extends ConsumerState<App> {
  late final GoRouter _router = createAppRouter(
    devRoutes: widget.devRoutes,
    devBranchRoutes: widget.devBranchRoutes,
  );

  @override
  void initState() {
    super.initState();
    _router.routerDelegate.addListener(_onRouteChanged);
  }

  void _onRouteChanged() {
    final uri = _router.routerDelegate.currentConfiguration.uri;
    // 화면을 그리는 도중(앱이 처음 뜰 때)에는 provider를 바꿀 수 없어, 그 프레임이
    // 끝난 뒤에 넣습니다. 버튼으로 옮겨 갈 때는 새 화면을 그리기 전에 바로 들어갑니다.
    if (SchedulerBinding.instance.schedulerPhase ==
        SchedulerPhase.persistentCallbacks) {
      SchedulerBinding.instance.addPostFrameCallback((_) {
        if (mounted) ref.read(currentLocationProvider.notifier).set(uri);
      });
    } else {
      ref.read(currentLocationProvider.notifier).set(uri);
    }
  }

  @override
  void dispose() {
    _router.routerDelegate.removeListener(_onRouteChanged);
    _router.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return MaterialApp.router(
      routerConfig: _router,
      onGenerateTitle: (context) => AppLocalizations.of(context).appTitle,
      localizationsDelegates: AppLocalizations.localizationsDelegates,
      supportedLocales: AppLocalizations.supportedLocales,
      locale: const Locale('ko'),
    );
  }
}
