import 'package:flutter/widgets.dart';
import 'package:go_router/go_router.dart';

/// 앱의 화면 이동 표(go_router).
///
/// 함수로 엽니다 — 목업 캔버스가 창마다 라우터를 새로 만들기 때문입니다.
/// 내비게이터 열쇠(`GlobalKey`)는 파일 맨 위 전역 값으로 두지 말고 이 함수
/// 안에서 만듭니다. 같은 열쇠가 두 라우터에 쓰이면 「열쇠가 겹친다」 오류가
/// 납니다(셸 경로의 열쇠도 같습니다).
///
/// 경로 문자열은 주소 모음(`paths.dart`)에서 가져다 씁니다.
///
/// 개발용 경로 주입 자리 — 실서비스 앱에 비교안이 들어가지 않게, 라우터는
/// `lib/dev/`를 직접 부르지 않고 경로를 인자로 받기만 합니다. 개발용 진입점
/// (`main_dev.dart`·`main_canvas.dart`)만 넘기고, `main_prod.dart`는 넘기지
/// 않습니다. 인자가 비면 아무 일도 안 합니다.
/// - [devRoutes]: 셸 밖 맨 위에 더할 개발용 경로(예: 디자인 시스템 페이지).
/// - [devBranchRoutes]: 하단 탭 이름별로 그 탭 가지 안에 더할 경로
///   (예: `{'home': [GoRoute(path: '/dev/innov/home', …)]}`) — 2-3 비교안이
///   하단 탭과 함께 뜨게 합니다. 가지를 만들 때 그 가지 경로 끝에 펼쳐 넣습니다.
GoRouter createAppRouter({
  String initialLocation = '/',
  List<RouteBase> devRoutes = const [],
  Map<String, List<RouteBase>> devBranchRoutes = const {},
}) {
  final rootKey = GlobalKey<NavigatorState>();
  return GoRouter(
    navigatorKey: rootKey,
    initialLocation: initialLocation,
    routes: [
      // 첫 화면 자리 — 2-0이 실제 화면으로 바꿉니다.
      GoRoute(path: '/', builder: (context, state) => const SizedBox.shrink()),
      // 하단 탭 셸을 만들면 가지마다 탭 이름으로 개발용 경로를 끝에 펼쳐 넣습니다 — 예:
      // StatefulShellRoute.indexedStack(
      //   builder: (context, state, shell) => AppShell(shell: shell),
      //   branches: [
      //     StatefulShellBranch(
      //       routes: [GoRoute(path: '/home', builder: …), ...?devBranchRoutes['home']],
      //     ),
      //   ],
      // ),
      ...devRoutes,
    ],
  );
}
