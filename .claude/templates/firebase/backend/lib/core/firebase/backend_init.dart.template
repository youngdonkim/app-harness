import 'package:firebase_core/firebase_core.dart';

import '../../app/flavor.dart';
import 'firebase_options_dev.dart' as dev;
import 'firebase_options_prod.dart' as prod;

/// 앱이 시작할 때 이 빌드의 Firebase 프로젝트에 붙습니다.
///
/// 개발용 빌드는 개발용 프로젝트, 실서비스 빌드는 실서비스 프로젝트 설정
/// 파일을 씁니다. 두 설정 파일은 FlutterFire CLI가 만듭니다.
Future<void> initBackend(AppFlavor flavor) async {
  final options = switch (flavor) {
    AppFlavor.dev => dev.DefaultFirebaseOptions.currentPlatform,
    AppFlavor.prod => prod.DefaultFirebaseOptions.currentPlatform,
  };
  await Firebase.initializeApp(options: options);
}
