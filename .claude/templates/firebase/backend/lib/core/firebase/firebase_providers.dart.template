import 'package:cloud_firestore/cloud_firestore.dart';
import 'package:cloud_functions/cloud_functions.dart';
import 'package:firebase_analytics/firebase_analytics.dart';
import 'package:firebase_auth/firebase_auth.dart';
import 'package:firebase_storage/firebase_storage.dart';
import 'package:riverpod_annotation/riverpod_annotation.dart';

part 'firebase_providers.g.dart';

/// Firebase 객체를 앱에 공급하는 유일한 자리.
///
/// 저장·조회 코드(repository)는 `FirebaseFirestore.instance`를 직접 부르지
/// 않고, 이 provider가 만든 객체를 생성자로 받습니다. 그래야 테스트에서 가짜를
/// 넣을 수 있습니다. `lib/features`·`lib/shared`에서 `.instance`를 부르면
/// `tool/check_firebase_config.dart`가 실패합니다.

@Riverpod(keepAlive: true)
FirebaseAuth firebaseAuth(Ref ref) => FirebaseAuth.instance;

@Riverpod(keepAlive: true)
FirebaseFirestore firestore(Ref ref) => FirebaseFirestore.instance;

@Riverpod(keepAlive: true)
FirebaseStorage firebaseStorage(Ref ref) => FirebaseStorage.instance;

/// 서버 함수는 리전을 꼭 맞춰 부릅니다 — `functions/src/config/region.ts`와 같은 값.
const functionsRegion = '<리전>';

@Riverpod(keepAlive: true)
FirebaseFunctions firebaseFunctions(Ref ref) =>
    FirebaseFunctions.instanceFor(region: functionsRegion);

@Riverpod(keepAlive: true)
FirebaseAnalytics firebaseAnalytics(Ref ref) => FirebaseAnalytics.instance;
