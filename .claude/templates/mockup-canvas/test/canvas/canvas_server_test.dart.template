// 코멘트 서버 검사 — 임시 폴더에 파일을 두고 실제 HTTP로 읽고 쓴다. 미리보기 그림 내보내기,
// 빈 포트 찾기·포트 파일, 응답의 프로젝트 이름도 본다.
import 'dart:convert';
import 'dart:io';

import 'package:flutter_test/flutter_test.dart';

import '../../tool/canvas_server.dart';

void main() {
  late Directory dir;
  late File file;
  late HttpServer server;
  final client = HttpClient();

  Future<(int, Map<String, Object?>)> send(
    String method, [
    Object? body,
  ]) async {
    final request = await client.openUrl(
      method,
      Uri.parse('http://127.0.0.1:${server.port}/comments'),
    );
    if (body != null) request.add(utf8.encode(jsonEncode(body)));
    final response = await request.close();
    final text = await response.transform(utf8.decoder).join();
    return (
      response.statusCode,
      (jsonDecode(text) as Map).cast<String, Object?>(),
    );
  }

  setUp(() async {
    dir = await Directory.systemTemp.createTemp('canvas_server_test');
    file = File('${dir.path}/mvp/canvas-comments.json');
    server = await startCanvasServer(
      file: file,
      shots: Directory('${dir.path}/shots'),
      port: 0,
      project: 'demo-app',
    );
  });

  tearDown(() async {
    await server.close(force: true);
    await dir.delete(recursive: true);
  });

  test('더하기 → 읽기 → 완료 표시가 파일에 남는다', () async {
    final (created, body) = await send('POST', {
      'screenId': 'S-01',
      'url': '/meetings?state=empty',
      'viewport': 'small',
      'state': 'empty',
      'comment': '  빈 상태 문구가 딱딱해요 ',
    });
    expect(created, 201);
    final comment = (body['comment'] as Map).cast<String, Object?>();
    expect(comment['status'], 'open');
    expect(comment['comment'], '빈 상태 문구가 딱딱해요');
    expect(comment['viewport'], 'small');

    expect(body['project'], 'demo-app');

    final (_, listed) = await send('GET');
    expect((listed['comments'] as List).length, 1);
    expect(listed['project'], 'demo-app');

    final (patched, done) = await send('PATCH', {
      'id': comment['id'],
      'status': 'done',
      'resolution': '문구를 바꿈',
    });
    expect(patched, 200);
    expect((done['comment'] as Map)['resolvedAt'], isNotNull);

    final saved = jsonDecode(await file.readAsString()) as List;
    expect((saved.single as Map)['resolution'], '문구를 바꿈');
  });

  test('필수 칸이 없으면 400, 없는 id는 404', () async {
    expect((await send('POST', {'screenId': 'S-01'})).$1, 400);
    expect((await send('PATCH', {'id': 'nope', 'status': 'done'})).$1, 404);
  });

  Future<(int, String?, List<int>)> getShot(String name) async {
    final request = await client.getUrl(
      Uri.parse('http://127.0.0.1:${server.port}/shots/$name'),
    );
    final response = await request.close();
    final bytes = await response.fold<List<int>>(
      [],
      (all, part) => all..addAll(part),
    );
    return (response.statusCode, response.headers.contentType?.mimeType, bytes);
  }

  test('미리보기 그림은 창 열쇠 이름으로만 내보낸다', () async {
    final folder = Directory('${dir.path}/shots')..createSync();
    File('${folder.path}/S-01__main__phone__base.png')
        .writeAsBytesSync([1, 2, 3]);
    File('${dir.path}/secret.png').writeAsBytesSync([9]);

    final (ok, type, bytes) = await getShot('S-01__main__phone__base.png');
    expect(ok, 200);
    expect(type, 'image/png');
    expect(bytes, [1, 2, 3]);
    expect((await getShot('S-09__main__phone__base.png')).$1, 404);
    expect((await getShot('..%2Fsecret.png')).$1, 404);
    expect((await getShot('S-01__main__phone__base.jpg')).$1, 404);
  });

  test('깨진 파일은 덮어쓰지 않는다', () async {
    await file.parent.create(recursive: true);
    await file.writeAsString('[깨짐');
    final (status, _) = await send('POST', {
      'screenId': 'S-01',
      'url': '/',
      'comment': 'x',
    });
    expect(status, 500);
    expect(await file.readAsString(), '[깨짐');
  });

  test('응답에 프로젝트 이름을 담는다 — 캔버스가 다른 프로젝트의 서버를 알아보게', () async {
    final request = await client.getUrl(
      Uri.parse('http://127.0.0.1:${server.port}/health'),
    );
    final response = await request.close();
    final json =
        jsonDecode(await response.transform(utf8.decoder).join()) as Map;
    expect(json['ok'], true);
    expect(json['project'], 'demo-app');
    expect(projectNameOf('/Users/me/dev/demo-app'), 'demo-app');
    expect(projectNameOf('/Users/me/dev/demo-app/'), 'demo-app');
  });

  test('앞 포트가 차 있으면 다음 빈 포트에 뜬다', () async {
    final blocker = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
    final next = await startCanvasServer(
      file: file,
      port: blocker.port,
      tries: 5,
    );
    try {
      expect(next.port, isNot(blocker.port));
      expect(next.port, greaterThan(blocker.port));
      expect(next.port, lessThan(blocker.port + 5));
    } finally {
      await next.close(force: true);
      await blocker.close(force: true);
    }
  });

  test('한 번만 보라고 하면 차 있는 포트에서 멈춘다', () async {
    final blocker = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
    try {
      await expectLater(
        startCanvasServer(file: file, port: blocker.port),
        throwsA(isA<SocketException>()),
      );
    } finally {
      await blocker.close(force: true);
    }
  });

  test('포트 파일 — 숫자 한 줄로 쓰고, 끌 때 자기 번호일 때만 지운다', () async {
    final portFile = File('${dir.path}/.dart_tool/canvas_server.port');
    await writeCanvasServerPort(portFile, 4725);
    expect(await portFile.readAsString(), '4725\n');

    await removeCanvasServerPort(portFile, 4726);
    expect(portFile.existsSync(), isTrue);

    await removeCanvasServerPort(portFile, 4725);
    expect(portFile.existsSync(), isFalse);
  });
}
