              message: '코멘트 달기 (C)',
              child: FilterChip(
                selected: _commentMode,
                avatar: const Icon(Icons.add_comment_outlined),
                label: const Text('코멘트 달기'),
                onSelected: (value) => setState(() => _commentMode = value),
              ),
            ),
            const SizedBox(width: 6),
            FilterChip(
              selected: _panelOpen,
              avatar: _serverOk == false ? const Icon(Icons.cloud_off) : null,
              label: Row(
                mainAxisSize: MainAxisSize.min,
                children: [
                  const Text('코멘트 보기'),
