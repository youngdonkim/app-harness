                          ),
                          TextButton(
                            onPressed: () => _setStatus(
                              comment,
                              comment.isOpen ? 'done' : 'open',
                            ),
                            child: Text(comment.isOpen ? '완료 표시' : '다시 열기'),
                          ),
                        ],
                      ),
                    ],
                  ),
                );
              },
            ),
          ),
        ],
      ),
    );
  }

  Widget _enlargedView(BuildContext context) {
    final colors = Theme.of(context).colorScheme;
    final text = Theme.of(context).textTheme;
    final tile = _enlarged!;
    final frame = tile.frame;
    final stage = tile.stage;
    final Widget body;
    if (frame != null) {
      body = CanvasPhone(
        key: ValueKey('enlarged:${frame.key}@$_textScale'),
        frame: frame,
        config: widget.config,
        textScale: _textScale,
        commentMode: _commentMode,
        pins: _pinsFor(frame),
        onPick: _onPick,
        onPinTap: (comment) => setState(() {
          _panelOpen = true;
          _highlight = comment.id;
        }),
      );
    } else {
      // 지난 단계는 그림뿐이다 — 크게 볼 때는 원래 크기로 풀어 흐리지 않게
      body = SizedBox.fromSize(
        size: CanvasViewport.phone.size,
        child: ClipRRect(
          borderRadius: BorderRadius.circular(24),
          child: _picture(context, tile, 1),
        ),
      );
    }
    return Material(
      color: colors.surfaceContainerHigh,
      child: SafeArea(
        child: Column(
          children: [
            Padding(
              padding: const EdgeInsets.fromLTRB(16, 8, 8, 8),
              child: Row(
                children: [
                  Expanded(
                    child: Text(
                      [?stage?.name, tile.title, tile.label].join(' · '),
                      style: text.titleLarge,
                      maxLines: 1,
                      overflow: TextOverflow.ellipsis,
                    ),
                  ),
                  if (frame != null)
                    FilterChip(
                      selected: _commentMode,
                      avatar: const Icon(Icons.add_comment_outlined),
                      label: const Text('코멘트 달기'),
                      onSelected: (value) =>
                          setState(() => _commentMode = value),
                    )
                  else
                    Text('지난 단계 그림이라 코멘트를 달 수 없습니다.', style: text.bodyMedium),
                  IconButton(
                    tooltip: '닫기 (Esc)',
                    icon: const Icon(Icons.close),
                    onPressed: () => setState(() => _enlarged = null),
                  ),
                ],
              ),
            ),
            Expanded(
              child: Padding(
                padding: const EdgeInsets.all(16),
                child: FittedBox(
                  key: const ValueKey('canvas-enlarged'),
                  child: body,
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget _pickCard(BuildContext context) {
    final colors = Theme.of(context).colorScheme;
    final text = Theme.of(context).textTheme;
    final pick = _pick!;
    final target = pick.target;
    final clue = [
      if (target.component != null) target.component!,
      if (target.text.isNotEmpty) '「${target.text}」',
      if (target.source != null) target.source!,
    ].join(' · ');
    return ColoredBox(
      color: colors.scrim.withValues(alpha: 0.32),
      child: Center(
        child: ConstrainedBox(
          constraints: const BoxConstraints(maxWidth: 480),
          child: Material(
            elevation: 8,
            borderRadius: BorderRadius.circular(16),
            child: Padding(
              padding: const EdgeInsets.all(20),
              child: Column(
                mainAxisSize: MainAxisSize.min,
                crossAxisAlignment: CrossAxisAlignment.stretch,
                children: [
                  Text('코멘트 남기기', style: text.titleLarge),
                  const SizedBox(height: 8),
                  Text(
                    '${pick.frame.screen.id} ${pick.frame.screen.name} · ${pick.frame.label}',
                    style: text.labelLarge,
                  ),
                  if (clue.isNotEmpty)
                    Text('누른 자리: $clue', style: text.bodySmall),
                  const SizedBox(height: 12),
                  TextField(
                    controller: _draftText,
                    autofocus: true,
                    minLines: 2,
                    maxLines: 5,
                    decoration: const InputDecoration(
                      border: OutlineInputBorder(),
                      hintText: '무엇을 어떻게 고치면 좋을지 적어 주세요',
                    ),
                  ),
                  if (_saveError != null) ...[
                    const SizedBox(height: 8),
                    Text(_saveError!, style: TextStyle(color: colors.error)),
                  ],
                  const SizedBox(height: 12),
                  Row(
                    mainAxisAlignment: MainAxisAlignment.end,
                    children: [
                      TextButton(
                        onPressed: () => setState(() => _pick = null),
                        child: const Text('취소'),
                      ),
                      const SizedBox(width: 8),
                      FilledButton(
                        onPressed: _saving ? null : _savePick,
                        child: Text(_saving ? '저장 중' : '핀 꽂기'),
                      ),
                    ],
                  ),
                ],
              ),
            ),
          ),
        ),
      ),
    );
  }
}

/// 화면 세로줄 머리 — 흐름 묶음 보기에서는 묶음이 바뀌는 첫 세로줄에 묶음 이름([group])도 단다
class _Header {
  const _Header({required this.title, required this.rect, this.group});

  final String? group;
  final String title;
  final Rect rect;
}

/// 단계 보기의 띠 머리 — 단계 이름과 설명
class _BandHead {
  const _BandHead({
    required this.title,
    required this.desc,
    required this.rect,
  });

  final String title;
  final String desc;
  final Rect rect;
}

/// 판 위 창 하나 — 지금 앱 창이면 [frame], 지난 단계 그림이면 [stage]의 [shotKey]
class _Tile {
  const _Tile({
    required this.id,
    required this.label,
    required this.title,
    this.frame,
    this.stage,
    this.shotKey,
  });

  /// 판 안에서 겹치지 않는 이름 — 지금 앱 창은 창 열쇠, 지난 단계는 `stage:<단계 이름>/<창 열쇠>`
  final String id;

  /// 창 위 이름표
  final String label;

  /// 화면 ID·이름 — 크게 볼 때 머리에 쓴다
  final String title;
  final CanvasFrame? frame;
  final CanvasStage? stage;
  final String? shotKey;
}
