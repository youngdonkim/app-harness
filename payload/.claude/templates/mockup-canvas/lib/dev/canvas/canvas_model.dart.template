// 목업 캔버스의 화면 목록·창 목록·코멘트 모양.
//
// 창 하나 = 화면 하나 × 상태 하나(기본·빈·로딩·오류·권한없음) × 판 하나(원래 화면·비교안). 폰 크기는 보통 폰 하나다.
// 화면 목록(screens.dart)을 buildFrames가 창 목록으로 펴고, 캔버스 판(canvas_app.dart)이 그 순서대로 놓는다.
// 창 열쇠(CanvasFrame.key)는 미리보기 그림 파일 이름에도 쓴다(.claude/templates/mockup-canvas/README.md 「미리보기 그림(골든 그림)」).
// 단계 보기(지난 단계 그림을 단계마다 한 띠로 놓는 보기)의 배치도 여기서 정한다 — buildStageLayout.

import 'package:flutter/material.dart';

import '../../core/dev_state/dev_state.dart';

/// 폰 크기 — 보통 폰(아이폰 16 폭) 하나만 띄운다.
/// 값이 하나뿐이어도 열거형으로 둔다 — 창 열쇠의 `__phone__` 조각과 코멘트의 `viewport: 'phone'`이 이 이름에서 나온다.
/// 좁은 폭에서 넘치는지는 캔버스 대신 넘침 검사 테스트(test/draft_checks/)가 작은 폰 폭으로 본다.
enum CanvasViewport {
  phone(
    label: '보통 폰',
    size: Size(390, 844),
    padding: EdgeInsets.only(top: 47, bottom: 34),
  );

  const CanvasViewport({
    required this.label,
    required this.size,
    required this.padding,
  });

  final String label;

  /// 화면 크기(dp)
  final Size size;

  /// 상태 표시줄·홈 표시줄 자리 — 화면의 SafeArea가 이만큼 비운다.
  final EdgeInsets padding;

  static CanvasViewport? parse(String? value) {
    for (final viewport in values) {
      if (viewport.name == value) return viewport;
    }
    return null;
  }
}

/// 상태 이름 — 창 이름표와 코멘트 단서에 쓴다.
String devStateLabel(DevState? state) => switch (state) {
  null => '기본',
  DevState.empty => '빈 상태',
  DevState.loading => '로딩',
  DevState.error => '오류',
  DevState.forbidden => '권한없음',
};

/// 비교안 줄의 처지 — 창 이름에 붙어, 사람이 캔버스에서 「어느 창이 지금 앱이고 어느 창이 비교안인가」를 읽는다.
/// 판을 고르면 목록 손 부분(screens.dart)에서 이 값만 바꾼다. 판 이름(label)은 그대로 두니 창 열쇠·골든 그림 이름·코멘트가 바뀌지 않는다.
enum DraftPick {
  /// 고르기 전 — 「{판} · 비교안」
  open('비교안'),

  /// 고른 판 — 「{판} · 고름」. 그 판이 본 화면 자리로 옮겨 가면 builder·theme·path를 지워 지금 앱을 띄운다
  picked('고름'),

  /// 고르지 않은 판 — 「{판} · 고르지 않음」. 3단계 `화면 대조 끝:` 때 고른 판 줄과 함께 지운다
  notPicked('고르지 않음'),

  /// 비교안이 아니라 지금 앱의 다른 모습(2-4 공간을 쓰기로 정한 뒤 남기는 가까이·많을 때 줄) — 「지금 앱 · {판}」
  app('지금 앱');

  const DraftPick(this.tag);

  final String tag;
}

/// 비교안 한 판 — 원래 화면 아래에 판마다 줄을 지어 놓인다.
///
/// [builder]·[path]는 많아야 하나다. 둘 다 없으면 원래 화면을 [theme]으로 띄운다. [theme]은 어느 쪽과도 함께 쓸 수 있다.
/// - [theme]만 — 같은 화면을 비교안 테마로 띄운다(값만 바꿔 보는 비교안). 예: `buildAppTheme(draftHomeB)`
/// - [builder] — 비교안 화면 위젯을 바로 띄운다(lib/dev/drafts/의 화면). 라우터 없이 뜨므로 화면 안 이동은 안 된다
/// - [path] — 라우터에 등록한 다른 경로를 띄운다
///
/// 머무는 공간(2-4)은 [focus]·[many]로 같은 화면의 「가까이」·「많을 때」 창을 더한다 — 창 열쇠에 붙어 그림 파일이 겹치지 않는다.
/// [pick]은 창 이름에만 붙는다(고르기 전 · 고름 · 고르지 않음 · 지금 앱).
class CanvasDraft {
  const CanvasDraft({
    required this.label,
    this.path,
    this.builder,
    this.theme,
    this.states,
    this.focus,
    this.many = false,
    this.pick = DraftPick.open,
  });

  final String label;
  final String? path;
  final WidgetBuilder? builder;
  final ThemeData? theme;

  /// 띄울 상태 — 안 적으면 원래 화면과 같다.
  final List<DevState>? states;

  /// 머무는 공간에서 처음부터 가까이 다가간 모습으로 그릴 물건 id — 창에 devFocusProvider로 들어간다
  final String? focus;

  /// 데이터가 많을 때 모습 — 창에 devManyProvider로 들어간다
  final bool many;

  /// 이 줄의 처지 — 창 이름 끝(지금 앱이면 앞)에 붙는다
  final DraftPick pick;
}

/// 캔버스에 띄울 화면 하나.
class CanvasScreen {
  const CanvasScreen({
    required this.id,
    required this.name,
    required this.group,
    this.path,
    this.builder,
    this.states = const [],
    this.guest = false,
    this.drafts = const [],
  }) : assert(
         path != null || builder != null,
         '경로(path)나 위젯(builder) 중 하나는 있어야 합니다',
       );

  /// 화면 ID — 화면 목록(mvp/feature-list.md 6절)의 ID와 같게(`S-01` 꼴)
  final String id;

  /// 화면 이름 — 사용자가 보는 이름
  final String name;

  /// 흐름 묶음 — 「역할: 흐름」 꼴. 같은 묶음끼리 왼쪽 목록에서 한 판으로 고른다.
  final String group;

  /// go_router 경로(예: `/meetings/m-01`). 끝에 `?as=guest`가 있으면 「로그인 전」으로 띄운다.
  final String? path;

  /// 경로 없이 위젯을 바로 띄울 때(디자인 시스템 페이지 등). 라우터 없이 뜬다.
  final WidgetBuilder? builder;

  /// 기본 모양 아래에 줄을 지어 띄울 상태
  final List<DevState> states;

  /// 「로그인 전」 모습으로 띄운다
  final bool guest;

  /// 비교안 — 화면 개선(2-2)·개성 입히기(2-3) 동안만 붙인다
  final List<CanvasDraft> drafts;

  CanvasScreen copyWith({
    String? name,
    String? group,
    String? path,
    WidgetBuilder? builder,
    List<DevState>? states,
    bool? guest,
    List<CanvasDraft>? drafts,
  }) => CanvasScreen(
    id: id,
    name: name ?? this.name,
    group: group ?? this.group,
    path: path ?? this.path,
    builder: builder ?? this.builder,
    states: states ?? this.states,
    guest: guest ?? this.guest,
    drafts: drafts ?? this.drafts,
  );
}

/// 자동 목록의 화면 하나에 덮어쓸 필드 — 적은 필드만 바뀐다. [skip]이면 캔버스에서 뺀다.
class CanvasOverride {
  const CanvasOverride({
    this.name,
    this.group,
    this.path,
    this.builder,
    this.states,
    this.guest,
    this.drafts,
    this.skip = false,
  });

  final String? name;
  final String? group;
  final String? path;
  final WidgetBuilder? builder;
  final List<DevState>? states;
  final bool? guest;
  final List<CanvasDraft>? drafts;
  final bool skip;
}

/// 자동 목록 + 덮어쓰기 + 더할 화면 → 캔버스가 읽는 목록. 배열 순서가 곧 흐름 순서다.
List<CanvasScreen> mergeScreens(
  List<CanvasScreen> generated,
  Map<String, CanvasOverride> overrides,
  List<CanvasScreen> extras,
) {
  final merged = <CanvasScreen>[];
  for (final screen in generated) {
    final change = overrides[screen.id];
    if (change == null) {
      merged.add(screen);
    } else if (!change.skip) {
      merged.add(
        screen.copyWith(
          name: change.name,
          group: change.group,
          path: change.path,
          builder: change.builder,
          states: change.states,
          guest: change.guest,
          drafts: change.drafts,
        ),
      );
    }
  }
  return [...merged, ...extras];
}

/// 흐름 묶음 이름 목록 — 처음 나온 차례대로
List<String> groupsOf(List<CanvasScreen> screens) {
  final groups = <String>[];
  for (final screen in screens) {
    if (!groups.contains(screen.group)) groups.add(screen.group);
  }
  return groups;
}

/// 캔버스 위 창 하나
class CanvasFrame {
  const CanvasFrame({
    required this.screen,
    required this.draft,
    required this.viewport,
    required this.state,
    required this.column,
    required this.row,
  });

  final CanvasScreen screen;

  /// 비교안이면 그 판, 원래 화면이면 null
  final CanvasDraft? draft;
  final CanvasViewport viewport;

  /// 기본 모양이면 null
  final DevState? state;

  /// 판에서 몇 번째 화면 세로줄인지(0부터)
  final int column;

  /// 그 화면 세로줄 안에서 몇 번째 줄인지 — 기본·상태·비교안마다 한 줄(한 줄에 창 하나)
  final int row;

  /// 창 열쇠 — 영문·숫자·-·_만. 예: `S-02__main__phone__empty`.
  /// 머무는 공간 창은 판 이름 뒤에 `-focus-{물건 id}`·`-many`가 붙는다. 예: `S-03__draft-stay-focus-shelf__phone__base`
  String get key {
    final d = draft;
    final variant = d == null
        ? 'main'
        : [
            'draft-${_slug(d.label)}',
            if (d.focus != null) 'focus-${_slug(d.focus!)}',
            if (d.many) 'many',
          ].join('-');
    return '${_slug(screen.id)}__${variant}__${viewport.name}__${state?.name ?? 'base'}';
  }

  /// 라우터에 넘길 경로(질의 `as=guest`는 뺀다). 위젯으로 띄우는 창이면 null
  String? get location {
    final raw = draft?.path ?? (draft?.builder != null ? null : screen.path);
    if (raw == null) return null;
    final uri = Uri.parse(raw);
    final query = Map.of(uri.queryParameters)
      ..remove('as')
      ..remove('state');
    return query.isEmpty
        ? uri.path
        : Uri(path: uri.path, queryParameters: query).toString();
  }

  /// 위젯으로 바로 띄우는 창이면 그 위젯
  WidgetBuilder? get builder =>
      draft?.builder ?? (draft?.path == null ? screen.builder : null);

  /// 「로그인 전」으로 띄우나
  bool get guest {
    final raw = draft?.path ?? screen.path;
    return screen.guest ||
        (raw != null && Uri.parse(raw).queryParameters['as'] == 'guest');
  }

  /// 코멘트에 적는 주소 — 경로에 `?state=`(머무는 공간이면 `?focus=`·`?state=many`)를 붙인 것(개발용 앱에서 같은 모습으로 여는 주소)
  String get url {
    var out = draft?.path ?? screen.path ?? 'widget:${screen.id}';
    void add(String query) =>
        out = '$out${out.contains('?') ? '&' : '?'}$query';
    final s = state;
    if (s != null) add('state=${s.name}');
    if (draft?.many ?? false) add('state=many');
    final f = draft?.focus;
    if (f != null) add('focus=${Uri.encodeQueryComponent(f)}');
    return out;
  }

  /// 창 이름 — 원래 화면은 「지금 앱 · 빈 상태」, 비교안은 「B판 · 비교안 · 기본」
  /// (고른 뒤 「· 고름」·「· 고르지 않음」, 지금 앱의 다른 모습이면 「지금 앱 · {판}」 — [DraftPick]).
  /// 폰 크기는 하나뿐이라 이름에 넣지 않는다.
  String get label {
    final d = draft;
    final head = d == null
        ? [DraftPick.app.tag]
        : d.pick == DraftPick.app
        ? [d.pick.tag, d.label]
        : [d.label, d.pick.tag];
    return [...head, devStateLabel(state)].join(' · ');
  }

  static String _slug(String text) {
    final slug = text
        .replaceAll(RegExp(r'[^A-Za-z0-9]+'), '-')
        .replaceAll(RegExp(r'^-|-$'), '');
    return slug.isEmpty ? 'x' : slug;
  }
}

/// 화면 목록을 창 목록으로 편다 — 배열 순서가 곧 캔버스 순서다.
List<CanvasFrame> buildFrames(List<CanvasScreen> screens) {
  final frames = <CanvasFrame>[];
  for (var column = 0; column < screens.length; column++) {
    final screen = screens[column];
    var row = 0;
    void add(CanvasDraft? draft, List<DevState> states) {
      for (final state in <DevState?>[null, ...states]) {
        frames.add(
          CanvasFrame(
            screen: screen,
            draft: draft,
            viewport: CanvasViewport.phone,
            state: state,
            column: column,
            row: row,
          ),
        );
        row += 1;
      }
    }

    add(null, screen.states);
    for (final draft in screen.drafts) {
      add(draft, draft.states ?? screen.states);
    }
  }
  return frames;
}

/// 코멘트를 남긴 자리의 단서 — Claude가 고칠 코드를 찾는 데 쓴다.
class CanvasCommentTarget {
  const CanvasCommentTarget({
    this.selector = '',
    this.text = '',
    this.source,
    this.component,
  });

  /// 누른 자리까지 이어진 위젯 이름 줄(프로젝트 코드가 만든 위젯만). 예: `MeetingListScreen > MeetingCard > Text`
  final String selector;

  /// 누른 자리의 글자 앞부분
  final String text;

  /// 누른 자리에 가장 가까운 프로젝트 위젯을 만든 코드 자리 「파일:줄」. 예: `lib/features/meetings/widgets/meeting_card.dart:41`
  final String? source;

  /// 그 위젯 이름. 예: `Text`
  final String? component;

  factory CanvasCommentTarget.fromJson(Map<String, Object?> json) =>
      CanvasCommentTarget(
        selector: json['selector'] as String? ?? '',
        text: json['text'] as String? ?? '',
        source: json['source'] as String?,
        component: json['component'] as String?,
      );

  Map<String, Object?> toJson() => {
    'selector': selector,
    'text': text,
    'source': source,
    'component': component,
  };
}

/// 코멘트 한 건 — mvp/canvas-comments.json에 배열로 쌓인다(사람이 남긴 수정 요청 기록, git에 올라간다).
class CanvasComment {
  const CanvasComment({
    required this.id,
    required this.screenId,
    required this.screenName,
    required this.draft,
    required this.url,
    required this.viewport,
    required this.state,
    required this.target,
    required this.position,
    required this.comment,
    required this.status,
    required this.resolution,
    required this.createdAt,
    required this.resolvedAt,
  });

  final String id;
  final String screenId;
  final String screenName;

  /// 비교안에 단 코멘트면 판 이름
  final String? draft;

  /// 창이 연 경로(`?state=` 포함)
  final String url;

  /// `phone`(보통 폰). 폰 크기가 둘이던 때 남긴 `small`(작은 폰)처럼 지금 모르는 값도 그대로 들고 있는다 —
  /// 파일을 다시 쓸 때 원래 값을 지우지 않게. 캔버스에서는 보통 폰 창에 꽂는다([belongsTo]).
  final String viewport;

  /// `empty`·`loading`·`error`·`forbidden`, 기본 모양이면 null
  final String? state;
  final CanvasCommentTarget target;

  /// 창 안 위치 — 화면 왼쪽 위에서 잰 거리(x·y, dp)와 누른 위젯 상자 안의 비율(rx·ry, 0~1)
  final ({double x, double y, double rx, double ry}) position;
  final String comment;

  /// `open`·`done`
  final String status;

  /// 처리 메모 — 고친 쪽(대개 Claude)이 무엇을 고쳤는지 적는다
  final String resolution;
  final String createdAt;
  final String? resolvedAt;

  bool get isOpen => status != 'done';

  /// 이 코멘트가 [frame] 창에 꽂히나 — 모르는 폰 크기(옛 `small`)는 보통 폰으로 친다
  bool belongsTo(CanvasFrame frame) =>
      screenId == frame.screen.id &&
      draft == frame.draft?.label &&
      (CanvasViewport.parse(viewport) ?? CanvasViewport.phone) ==
          frame.viewport &&
      state == frame.state?.name;

  factory CanvasComment.fromJson(Map<String, Object?> json) {
    final position =
        (json['position'] as Map?)?.cast<String, Object?>() ?? const {};
    double number(String key) => (position[key] as num?)?.toDouble() ?? 0;
    return CanvasComment(
      id: json['id'] as String? ?? '',
      screenId: json['screenId'] as String? ?? '',
      screenName: json['screenName'] as String? ?? '',
      draft: json['draft'] as String?,
      url: json['url'] as String? ?? '',
      viewport: json['viewport'] as String? ?? 'phone',
      state: json['state'] as String?,
      target: CanvasCommentTarget.fromJson(
        (json['target'] as Map?)?.cast<String, Object?>() ?? const {},
      ),
      position: (
        x: number('x'),
        y: number('y'),
        rx: number('rx'),
        ry: number('ry'),
      ),
      comment: json['comment'] as String? ?? '',
      status: json['status'] as String? ?? 'open',
      resolution: json['resolution'] as String? ?? '',
      createdAt: json['createdAt'] as String? ?? '',
      resolvedAt: json['resolvedAt'] as String?,
    );
  }

  Map<String, Object?> toJson() => {
    'id': id,
    'screenId': screenId,
    'screenName': screenName,
    'draft': draft,
    'url': url,
    'viewport': viewport,
    'state': state,
    'target': target.toJson(),
    'position': {
      'x': position.x,
      'y': position.y,
      'rx': position.rx,
      'ry': position.ry,
    },
    'comment': comment,
    'status': status,
    'resolution': resolution,
    'createdAt': createdAt,
    'resolvedAt': resolvedAt,
  };
}

/// 새 코멘트 — 서버가 id·status·createdAt을 붙여 CanvasComment로 저장한다.
Map<String, Object?> newCommentBody({
  required CanvasFrame frame,
  required CanvasCommentTarget target,
  required Offset position,
  required Offset ratio,
  required String comment,
}) => {
  'screenId': frame.screen.id,
  'screenName': frame.screen.name,
  'draft': frame.draft?.label,
  'url': frame.url,
  'viewport': frame.viewport.name,
  'state': frame.state?.name,
  'target': target.toJson(),
  'position': {
    'x': position.dx,
    'y': position.dy,
    'rx': ratio.dx,
    'ry': ratio.dy,
  },
  'comment': comment,
};

// ── 단계 보기 ──────────────────────────────────────────

/// 지난 단계 하나 — 코멘트 서버의 GET /stages가 준 것. 그림은 프로젝트 맨 위 `.canvas-stages/<단계 이름>/`에 있다
/// (`.claude/scripts/stage-shots.sh`가 단계 태그마다 찍는다).
class CanvasStage {
  const CanvasStage({
    required this.name,
    this.desc = '',
    this.date = '',
    this.keys = const [],
  });

  /// 단계 이름 — 태그 이름에서 `stage/`를 뗀 것(예: `2-3-drafts`). 그림 주소에도 쓴다
  final String name;

  /// 한 줄 설명
  final String desc;

  /// 그 단계 커밋의 시각(ISO 8601)
  final String date;

  /// 그 단계에 찍어 둔 그림의 창 열쇠 — 이름순
  final List<String> keys;

  factory CanvasStage.fromJson(Map<String, Object?> json) => CanvasStage(
    name: json['name'] as String? ?? '',
    desc: json['desc'] as String? ?? '',
    date: json['date'] as String? ?? '',
    keys: [
      for (final key in json['keys'] as List? ?? const [])
        if (key is String) key,
    ],
  );
}

/// 창 열쇠를 화면 id 조각·판 조각으로 가른다. 보통 폰 기본 모양(`…__phone__base`)이 아니면 null —
/// 단계 보기는 화면마다 기본 모양만 놓는다.
({String screenId, String variant})? parseBaseKey(String key) {
  final parts = key.split('__');
  if (parts.length != 4 ||
      parts[2] != CanvasViewport.phone.name ||
      parts[3] != 'base') {
    return null;
  }
  return (screenId: parts[0], variant: parts[1]);
}

/// 단계 보기의 화면 세로줄 하나 — 모든 띠에서 같은 x 자리다
class StageColumn {
  const StageColumn({required this.id, this.screen});

  /// 창 열쇠의 화면 id 조각
  final String id;

  /// 지금 화면 목록에 있는 화면이면 그 화면. 지난 단계에만 있는 화면이면 null(머리 이름은 [id] 그대로)
  final CanvasScreen? screen;

  String get title => screen == null ? id : '${screen!.id}  ${screen!.name}';
}

/// 단계 보기의 창 자리 하나 — 「지금 앱」 띠면 [frame], 지난 단계면 [stage]의 그림 [key]
class StageCell {
  const StageCell({
    required this.column,
    required this.row,
    required this.key,
    this.frame,
    this.stage,
  });

  /// 몇 번째 화면 세로줄인지(0부터)
  final int column;

  /// 띠 안에서 그 세로줄의 몇 번째 창인지(0부터) — 원래 화면 → 비교안 차례로 쌓는다
  final int row;

  /// 창 열쇠
  final String key;
  final CanvasFrame? frame;
  final CanvasStage? stage;

  /// 창 이름 — 지금 앱 창은 [CanvasFrame.label], 지난 단계 그림은 「원래 화면」·「비교안 {판 조각}」
  String get label {
    final f = frame;
    if (f != null) return f.label;
    final variant = parseBaseKey(key)?.variant ?? key;
    return variant == 'main'
        ? '원래 화면'
        : '비교안 ${variant.replaceFirst('draft-', '')}';
  }
}

/// 단계 보기의 띠 하나 — 단계 하나를 가로 한 줄로
class StageBand {
  const StageBand({
    required this.stage,
    required this.cells,
    required this.rows,
  });

  /// 지난 단계면 그 단계, 「지금 앱」 띠면 null
  final CanvasStage? stage;
  final List<StageCell> cells;

  /// 가장 많이 쌓인 세로줄의 창 수 — 띠 높이가 이것에 맞는다
  final int rows;
}

class StageLayout {
  const StageLayout({required this.columns, required this.bands});

  final List<StageColumn> columns;

  /// 지난 단계(서버가 준 차례 = 날짜순) 뒤에 맨 끝 「지금 앱」
  final List<StageBand> bands;
}

/// 단계 보기 배치 — 띠는 [stages] 차례대로 놓고 [showNow]면 맨 끝에 「지금 앱」 띠를 붙인다.
///
/// - 세로줄: 지금 화면 목록 차례, 그 뒤에 지난 단계에만 있는 화면 id를 이름순. 놓인 창이 하나도 없는 세로줄은 뺀다.
/// - 「지금 앱」 띠: 지금 창 가운데 기본 모양(state == null)만 — 원래 화면과 남은 비교안 줄.
/// - 지난 단계 띠: 그 단계 그림 가운데 보통 폰 기본 모양만. 한 세로줄 안은 원래 화면(main) → 비교안 차례이고,
///   비교안끼리는 지금 화면 목록의 판 차례(없는 판은 그 뒤에 이름순)를 따른다. 그림이 하나도 없는 단계는 띠를 만들지 않는다.
StageLayout buildStageLayout(
  List<CanvasScreen> screens,
  List<CanvasStage> stages, {
  bool showNow = true,
}) {
  final nowFrames = buildFrames(screens)
      .where((frame) => frame.state == null)
      .toList();
  final screenById = <String, CanvasScreen>{};
  for (final screen in screens) {
    screenById.putIfAbsent(CanvasFrame._slug(screen.id), () => screen);
  }

  // 화면마다 지금 판 차례 — 지난 단계 비교안을 같은 차례로 쌓으려고
  final variantOrder = <String, List<String>>{};
  for (final frame in nowFrames) {
    final parsed = parseBaseKey(frame.key);
    if (parsed == null) continue;
    variantOrder.putIfAbsent(parsed.screenId, () => []).add(parsed.variant);
  }

  // 띠마다 화면 id → 그 세로줄에 쌓을 창(열쇠·지금 창)
  final bandStacks =
      <
        ({CanvasStage? stage, Map<String, List<(String, CanvasFrame?)>> stacks})
      >[];
  for (final stage in stages) {
    final stacks = <String, List<(String, CanvasFrame?)>>{};
    for (final key in stage.keys) {
      final parsed = parseBaseKey(key);
      if (parsed == null) continue;
      stacks.putIfAbsent(parsed.screenId, () => []).add((key, null));
    }
    if (stacks.isEmpty) continue;
    for (final entry in stacks.entries) {
      final order = variantOrder[entry.key] ?? const [];
      int rank(String key) {
        final variant = parseBaseKey(key)!.variant;
        if (variant == 'main') return -1;
        final index = order.indexOf(variant);
        return index < 0 ? order.length : index;
      }

      entry.value.sort((a, b) {
        final byRank = rank(a.$1).compareTo(rank(b.$1));
        return byRank != 0 ? byRank : a.$1.compareTo(b.$1);
      });
    }
    bandStacks.add((stage: stage, stacks: stacks));
  }
  if (showNow) {
    final stacks = <String, List<(String, CanvasFrame?)>>{};
    for (final frame in nowFrames) {
      stacks.putIfAbsent(CanvasFrame._slug(frame.screen.id), () => []).add((
        frame.key,
        frame,
      ));
    }
    bandStacks.add((stage: null, stacks: stacks));
  }

  final used = {for (final band in bandStacks) ...band.stacks.keys};
  final ids = <String>[
    for (final id in screenById.keys)
      if (used.contains(id)) id,
    ...(used.where((id) => !screenById.containsKey(id)).toList()..sort()),
  ];
  final columnOf = {for (var i = 0; i < ids.length; i++) ids[i]: i};

  return StageLayout(
    columns: [
      for (final id in ids) StageColumn(id: id, screen: screenById[id]),
    ],
    bands: [
      for (final band in bandStacks)
        StageBand(
          stage: band.stage,
          rows: band.stacks.values.fold(
            0,
            (most, stack) => stack.length > most ? stack.length : most,
          ),
          cells:
              [
                for (final entry in band.stacks.entries)
                  for (var row = 0; row < entry.value.length; row++)
                    StageCell(
                      column: columnOf[entry.key]!,
                      row: row,
                      key: entry.value[row].$1,
                      frame: entry.value[row].$2,
                      stage: band.stage,
                    ),
              ]..sort(
                (a, b) => a.column != b.column
                    ? a.column.compareTo(b.column)
                    : a.row.compareTo(b.row),
              ),
        ),
    ],
  );
}

// ── 판 그리기 도우미 ───────────────────────────────────

/// 화면 밖 창은 만들지 않는다 — 보이는 영역(장면 좌표)을 둘레로 그 크기만큼 넓힌 범위 안의 창만 만든다.
/// 넉넉히 넓혀 두니 조금 옮길 때마다 다시 잴 일이 없다.
Rect buildAreaAround(Rect visible) => Rect.fromLTRB(
  visible.left - visible.width,
  visible.top - visible.height,
  visible.right + visible.width,
  visible.bottom + visible.height,
);

/// 지금 만든 범위 [built]를 다시 재야 하나 — 보이는 영역이 범위를 벗어났거나,
/// 확대해 들어가 범위가 보이는 영역보다 지나치게 커졌을 때(폭이 6배 넘게)
bool needsNewBuildArea(Rect? built, Rect visible) {
  if (built == null) return true;
  final inside =
      visible.left >= built.left &&
      visible.top >= built.top &&
      visible.right <= built.right &&
      visible.bottom <= built.bottom;
  return !inside || built.width > visible.width * 6;
}

/// [rects] 가운데 [area]와 겹치는 것의 열쇠
Set<String> keysInArea(Map<String, Rect> rects, Rect area) => {
  for (final entry in rects.entries)
    if (entry.value.overlaps(area)) entry.key,
};

/// 미리보기 그림을 창 폭의 몇 배로 풀지 — 멀리서 볼수록 작게 풀어 메모리를 던다.
/// 경계를 넘을 때마다 그림을 다시 받으니 단계는 셋만 둔다. 1이면 그림 원래 크기 그대로 푼다.
double shotDetailFor(double scale) => scale < 0.15
    ? 0.25
    : scale < 0.4
    ? 0.6
    : 1.0;
