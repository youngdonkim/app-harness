// Storage 보안 규칙 테스트 — storage.rules가 있을 때만 CI가 Storage 에뮬레이터를 띄웁니다.
import { after, before, describe, test } from "node:test";
import { assertFails, assertSucceeds, type RulesTestEnvironment } from "@firebase/rules-unit-testing";
import { ref, uploadBytes } from "firebase/storage";
import { makeEnv } from "./setup.ts";

const enabled = !!process.env.FIREBASE_STORAGE_EMULATOR_HOST;
let env: RulesTestEnvironment;

describe("storage", { skip: !enabled && "Storage 에뮬레이터가 없어 건너뜀" }, () => {
  before(async () => {
    env = await makeEnv();
  });
  after(async () => {
    await env.cleanup();
  });

  const png = new Uint8Array([0x89, 0x50, 0x4e, 0x47]);

  test("본인 폴더에 이미지는 올린다", async () => {
    const storage = env.authenticatedContext("alice").storage();
    await assertSucceeds(uploadBytes(ref(storage, "users/alice/a.png"), png, { contentType: "image/png" }));
  });

  test("남의 폴더에는 못 올린다", async () => {
    const storage = env.authenticatedContext("bob").storage();
    await assertFails(uploadBytes(ref(storage, "users/alice/b.png"), png, { contentType: "image/png" }));
  });

  test("이미지가 아니면 못 올린다", async () => {
    const storage = env.authenticatedContext("alice").storage();
    await assertFails(uploadBytes(ref(storage, "users/alice/a.txt"), png, { contentType: "text/plain" }));
  });
});
