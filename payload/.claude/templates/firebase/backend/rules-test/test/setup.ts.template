// 보안 규칙 테스트 공통 준비.
//
// 에뮬레이터는 firebase emulators:exec가 띄우고, 주소는 환경변수
// (FIRESTORE_EMULATOR_HOST·FIREBASE_STORAGE_EMULATOR_HOST)로 알려 줍니다.
// 프로젝트 ID는 demo-로 시작하는 가짜 — 실제 Firebase에 닿지 않습니다.
// CI 명령의 --project demo-rules-test와 같은 값이어야 합니다.
import { readFileSync } from "node:fs";
import { initializeTestEnvironment, type RulesTestEnvironment } from "@firebase/rules-unit-testing";

export const PROJECT_ID = "demo-rules-test";

export async function makeEnv(): Promise<RulesTestEnvironment> {
  const root = new URL("../../", import.meta.url);
  const hasStorage = !!process.env.FIREBASE_STORAGE_EMULATOR_HOST;
  return initializeTestEnvironment({
    projectId: PROJECT_ID,
    firestore: { rules: readFileSync(new URL("firestore.rules", root), "utf8") },
    ...(hasStorage
      ? { storage: { rules: readFileSync(new URL("storage.rules", root), "utf8") } }
      : {}),
  });
}
