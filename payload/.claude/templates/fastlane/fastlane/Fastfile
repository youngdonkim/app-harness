# Fastfile — 플레이에 올리는 일을 이 한 파일에 모읍니다.
#
# 부르는 꼴 (프로젝트 맨 위, main에서만, 실행기를 앞에 붙여서):
#   .claude/scripts/with-owner.sh bundle exec fastlane <lane> [이름:값 ...]
#
# lane 목록
#   check_key                       서비스 계정 키로 플레이에 닿는지만 확인(아무것도 바꾸지 않음)
#   upload  track:internal          앱 번들 + 이번 빌드 번호의 변경 내역을 그 트랙에 올림
#           track:production rollout:0.1   프로덕션에 단계적 출시(사용자 10%부터). 1이면 전체
#           dry_run:true            플레이에 「검사만」 요청하고 실제로는 올리지 않음
#   listing track:internal          스토어 정보(글·그림·스크린샷)만 올림 — 앱 번들은 안 올림
#   rollout version_code:12 rollout:0.5    프로덕션 단계적 출시 비율 올리기(1이면 전체)
#   halt    version_code:12         프로덕션 단계적 출시 멈추기(이미 받은 사람은 그대로)
#   promote version_code:12 from:internal to:production [rollout:0.1]   이미 올린 번들을 다른 트랙으로
#
# 트랙 이름(플레이 API 기준): internal(내부 테스트) · alpha(비공개 테스트) · beta(공개 테스트) · production(프로덕션)
#
# 지키는 것
#   - main에서만, 커밋 안 된 변경이 없을 때만 돕니다(before_all). 감시 훅도 main이 아니면 막습니다.
#   - 서비스 계정 키는 장부의 PLAY_SERVICE_ACCOUNT_FILE(실행기가 넣음)로만 받습니다. 키 내용·비밀번호를 여기 적지 않습니다.
#   - 앱 번들이 개발용(debug) 서명이면 올리지 않습니다.
#   - 스토어 정보는 git으로 관리하는 metadata/ 폴더가 정본입니다. 콘솔에서 바꾼 것은 다음 listing 때 덮입니다.
#   - 한 번도 검토를 통과해 출시된 적 없는 앱(Draft App)에는 「완료」 상태로 올릴 수 없습니다
#     (Only releases with status draft may be created on draft app). 그동안은 콘솔에서 손으로 올립니다.

default_platform(:android)

ROOT = File.expand_path("..", FastlaneCore::FastlaneFolder.path)
META = File.join(ROOT, "fastlane", "metadata", "android")
AAB = File.join(ROOT, "build", "app", "outputs", "bundle", "prodRelease", "app-prod-release.aab")
TRACKS = %w[internal alpha beta production].freeze

load File.join(ROOT, "fastlane", "check_metadata.rb")

def track_from(options, key = :track)
  track = options[key].to_s
  UI.user_error!("#{key}:를 적어 주세요 — #{TRACKS.join(' · ')} 중 하나") if track.empty?
  UI.user_error!("모르는 트랙: #{track} — #{TRACKS.join(' · ')} 중 하나") unless TRACKS.include?(track)
  track
end

def dry_run?(options)
  options[:dry_run].to_s == "true"
end

def rollout_from(options)
  value = options[:rollout].to_s
  return nil if value.empty?

  f = Float(value) rescue UI.user_error!("rollout:은 0보다 크고 1 이하인 수입니다 (예: 0.1)")
  UI.user_error!("rollout:은 0보다 크고 1 이하인 수입니다 (예: 0.1)") unless f > 0 && f <= 1
  value
end

def version_code_from(options)
  value = options[:version_code].to_s
  UI.user_error!("version_code:를 적어 주세요 (pubspec.yaml의 version 뒤 + 숫자)") unless value.match?(/\A\d+\z/)
  value.to_i
end

# pubspec.yaml의 `version: x.y.z+N`에서 N(빌드 번호 = versionCode)을 읽습니다.
def pubspec_build_number
  line = File.readlines(File.join(ROOT, "pubspec.yaml")).find { |l| l.start_with?("version:") }
  m = line && line.match(/\+(\d+)\s*\z/)
  UI.user_error!("pubspec.yaml의 version이 x.y.z+N 꼴이 아닙니다") unless m
  m[1].to_i
end

def check_metadata!(version_code: nil)
  problems = MetadataCheck.run(META, version_code: version_code)
  return if problems.empty?

  problems.each { |p| UI.error(p) }
  UI.user_error!("스토어 정보 점검에서 #{problems.length}건 — 고친 뒤 다시 부르세요(ruby fastlane/check_metadata.rb)")
end

# 앱 번들의 서명이 개발용(debug) 서명이 아닌지 봅니다. 업로드 키가 연결되지 않은 채 빌드하면 debug로 서명됩니다.
def check_upload_signature!(aab)
  out = sh("keytool", "-printcert", "-jarfile", aab, log: false)
  UI.user_error!("앱 번들이 개발용(debug) 서명입니다 — 업로드 키를 연결하고 다시 빌드하세요") if out.include?("CN=Android Debug")
  UI.user_error!("앱 번들에서 서명을 읽지 못했습니다") unless out.match?(/SHA256/i)
end

before_all do
  ensure_git_branch(branch: "^main$")
  ensure_git_status_clean
  key = ENV["PLAY_SERVICE_ACCOUNT_FILE"].to_s
  UI.user_error!("서비스 계정 키가 없습니다 — 실행기(.claude/scripts/with-owner.sh)를 앞에 붙여 부르고, 장부의 PLAY_SERVICE_ACCOUNT_FILE을 확인하세요") unless !key.empty? && File.file?(key)
end

platform :android do
  desc "서비스 계정 키로 플레이에 닿는지만 확인합니다"
  lane :check_key do
    validate_play_store_json_key(json_key: ENV["PLAY_SERVICE_ACCOUNT_FILE"])
  end

  desc "앱 번들과 이번 빌드 번호의 변경 내역을 트랙에 올립니다"
  lane :upload do |options|
    track = track_from(options)
    aab = options[:aab].to_s.empty? ? AAB : File.expand_path(options[:aab].to_s, ROOT)
    UI.user_error!("앱 번들이 없습니다 — store-release의 「앱 번들 만들기」부터: #{aab}") unless File.file?(aab)

    code = pubspec_build_number
    check_metadata!(version_code: code)
    check_upload_signature!(aab)

    params = {
      track: track,
      aab: aab,
      metadata_path: META,
      release_status: "completed",
      skip_upload_apk: true,
      skip_upload_metadata: true, # 스토어 정보는 listing lane으로 따로 — 측정 기간에 실수로 바뀌지 않게
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false,
      validate_only: dry_run?(options)
    }
    rollout = rollout_from(options)
    if rollout && rollout.to_f < 1
      UI.user_error!("단계적 출시(rollout:)는 production에서만 씁니다") unless track == "production"
      params[:release_status] = "inProgress"
      params[:rollout] = rollout
    end
    upload_to_play_store(**params)
  end

  desc "스토어 정보(글·그림·스크린샷)만 올립니다"
  lane :listing do |options|
    track = options[:track].to_s.empty? ? "internal" : track_from(options)
    check_metadata!
    upload_to_play_store(
      track: track,
      metadata_path: META,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
      sync_image_upload: true, # 바뀐 그림만 올림
      validate_only: dry_run?(options)
    )
  end

  desc "프로덕션 단계적 출시 비율을 바꿉니다(1이면 전체)"
  lane :rollout do |options|
    code = version_code_from(options)
    rollout = rollout_from(options) || UI.user_error!("rollout:을 적어 주세요 (예: 0.5, 전체는 1)")
    upload_to_play_store(
      track: "production",
      version_code: code,
      rollout: rollout,
      release_status: rollout.to_f < 1 ? "inProgress" : "completed",
      skip_upload_apk: true, skip_upload_aab: true, skip_upload_metadata: true,
      skip_upload_changelogs: true, skip_upload_images: true, skip_upload_screenshots: true,
      validate_only: dry_run?(options)
    )
  end

  desc "프로덕션 단계적 출시를 멈춥니다(이미 받은 사람은 그대로)"
  lane :halt do |options|
    code = version_code_from(options)
    upload_to_play_store(
      track: "production",
      version_code: code,
      release_status: "halted",
      skip_upload_apk: true, skip_upload_aab: true, skip_upload_metadata: true,
      skip_upload_changelogs: true, skip_upload_images: true, skip_upload_screenshots: true,
      validate_only: dry_run?(options)
    )
  end

  desc "이미 올린 빌드 번호를 다른 트랙으로 옮깁니다"
  lane :promote do |options|
    code = version_code_from(options)
    from = track_from(options, :from)
    to = track_from(options, :to)
    rollout = rollout_from(options)
    staged = rollout && rollout.to_f < 1
    UI.user_error!("단계적 출시(rollout:)는 production으로 옮길 때만 씁니다") if staged && to != "production"
    params = {
      track: from,
      track_promote_to: to,
      version_code: code,
      track_promote_release_status: staged ? "inProgress" : "completed",
      skip_upload_apk: true, skip_upload_aab: true, skip_upload_metadata: true,
      skip_upload_changelogs: true, skip_upload_images: true, skip_upload_screenshots: true,
      validate_only: dry_run?(options)
    }
    params[:rollout] = rollout if staged
    upload_to_play_store(**params)
  end
end
